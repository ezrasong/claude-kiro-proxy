+    def _feed_frames(self, chunk: bytes) -> List[Dict[str, Any]]:
+        """Decode complete AWS frames without losing split UTF-8 or native reasoning.
+
+        Args:
+            chunk: Bytes from a binary AWS event stream.
+
+        Returns:
+            Parsed events; incomplete frames remain buffered.
+
+        Raises:
+            ValueError: Invalid length, checksum, headers, or JSON payload.
+        """
+        self._frame_buffer.extend(chunk)
+        events: List[Dict[str, Any]] = []
+        while len(self._frame_buffer) >= 12:
+            length, header_length, prelude_crc = struct.unpack('>III', self._frame_buffer[:12])
+            if length < 16 or length >= 16 * 1024 * 1024 or header_length > length - 16:
+                raise ValueError('Invalid AWS event-stream frame length')
+            if zlib.crc32(self._frame_buffer[:8]) != prelude_crc:
+                raise ValueError('Invalid AWS event-stream prelude checksum')
+            if len(self._frame_buffer) < length:
+                break
+            frame = bytes(self._frame_buffer[:length])
+            del self._frame_buffer[:length]
+            if zlib.crc32(frame[:-4]) != int.from_bytes(frame[-4:], 'big'):
+                raise ValueError('Invalid AWS event-stream message checksum')
+            event_type = self._frame_event_type(frame[12:12 + header_length])
+            try:
+                data = json.loads(frame[12 + header_length:-4])
+            except (UnicodeError, json.JSONDecodeError) as exc:
+                raise ValueError('Invalid AWS event-stream JSON payload') from exc
+            if not isinstance(data, dict):
+                raise ValueError('Invalid AWS event-stream payload type')
+            if event_type == 'reasoningContentEvent':
+                text = data.get('text')
+                if isinstance(text, str) and text:
+                    events.append({'type': 'thinking', 'data': text})
+                signature = data.get('signature')
+                if isinstance(signature, str) and signature:
+                    events.append({'type': 'thinking_signature', 'data': signature})
+                continue
+            kinds = {
+                'assistantResponseEvent': 'content',
+                'contextUsageEvent': 'context_usage',
+                'meteringEvent': 'usage',
+                'metadataEvent': 'metadata',
+            }
+            kind = kinds.get(event_type)
+            if event_type == 'toolUseEvent':
+                current_id = self.current_tool_call['id'] if self.current_tool_call else None
+                if 'name' in data and (self.current_tool_call is None or data.get('toolUseId') not in (None, current_id)):
+                    self._process_tool_start_event(data)
+                else:
+                    if 'input' in data:
+                        self._process_tool_input_event(data)
+                    if data.get('stop'):
+                        self._process_tool_stop_event(data)
+                continue
+            if kind:
+                event = self._process_event(data, kind)
+                if event:
+                    events.append(event)
+        return events
+
+    @staticmethod
+    def _frame_event_type(headers: bytes) -> Optional[str]:
+        """Read the AWS event-type string while validating all header boundaries.
+
+        Args:
+            headers: The header section of a complete AWS frame.
+
+        Returns:
+            Event type, or None when absent.
+
+        Raises:
+            ValueError: A header type, length, or string is malformed.
+        """
+        offset = 0
+        event_type = None
+        fixed_sizes = {0: 0, 1: 0, 2: 1, 3: 2, 4: 4, 5: 8, 8: 8, 9: 16}
+        while offset < len(headers):
+            name_length = headers[offset]
+            offset += 1
+            if offset + name_length + 1 > len(headers):
+                raise ValueError('Invalid AWS event-stream header')
+            name = headers[offset:offset + name_length]
+            offset += name_length
+            value_type = headers[offset]
+            offset += 1
+            if value_type in (6, 7):
+                if offset + 2 > len(headers):
+                    raise ValueError('Invalid AWS event-stream header')
+                size = int.from_bytes(headers[offset:offset + 2], 'big')
+                offset += 2
+            elif value_type in fixed_sizes:
+                size = fixed_sizes[value_type]
+            else:
+                raise ValueError('Invalid AWS event-stream header type')
+            if offset + size > len(headers):
+                raise ValueError('Invalid AWS event-stream header')
+            if name == b':event-type':
+                if value_type != 7:
+                    raise ValueError('Invalid AWS event-stream event type')
+                try:
+                    event_type = headers[offset:offset + size].decode('utf-8')
+                except UnicodeError as exc:
+                    raise ValueError('Invalid AWS event-stream event type') from exc
+            offset += size
+        return event_type
+
