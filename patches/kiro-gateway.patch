+_KEEPALIVE_SECONDS = 15
+
+
+async def _with_anthropic_keepalive(source):
+    """Keep the local connection alive without cancelling or restarting Kiro.
+
+    The formatter yields complete SSE frames. A pending read survives each ping;
+    cancellation closes it before closing the generator and its HTTP response.
+    Kiro's HTTP read timeout still owns the upstream inactivity deadline.
+    """
+    pending = None
+    try:
+        while True:
+            pending = asyncio.create_task(anext(source))
+            while True:
+                done, _ = await asyncio.wait({pending}, timeout=_KEEPALIVE_SECONDS)
+                if done:
+                    break
+                yield format_sse_event("ping", {"type": "ping"})
+            completed, pending = pending, None
+            try:
+                chunk = completed.result()
+            except StopAsyncIteration:
+                return
+            yield chunk
+    finally:
+        if pending is not None:
+            pending.cancel()
+            with suppress(asyncio.CancelledError, Exception):
+                await pending
+        await source.aclose()
