+def count_output_tokens(content: str, thinking: str, tool_calls: List[Dict[str, Any]]) -> int:
+    """Estimate generated tokens including tool names and JSON arguments.
+
+    Args:
+        content: Generated response text.
+        thinking: Generated reasoning text.
+        tool_calls: Completed, deduplicated calls in the shared parser format.
+
+    Returns:
+        Approximate output tokens, using the same tokenizer as ordinary text.
+    """
+    tools = []
+    for call in tool_calls:
+        function = call.get('function') or {}
+        name = function.get('name') or call.get('name') or ''
+        arguments = function.get('arguments', call.get('input', {}))
+        if not isinstance(arguments, str):
+            arguments = json.dumps(arguments, ensure_ascii=False)
+        tools.append(name + arguments)
+    return count_tokens(content + thinking + ''.join(tools))
+
