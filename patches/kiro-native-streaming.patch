+                    raise ValueError('Invalid AWS event-stream header')
+                size = int.from_bytes(headers[offset:offset + 2], 'big')
+                offset += 2
+            elif value_type in fixed_sizes:
+                size = fixed_sizes[value_type]
+            else:
+                raise ValueError('Invalid AWS event-stream header type')
+            if offset + size > len(headers):
+                raise ValueError('Invalid AWS event-stream header')
+            if name == b':event-type':
+                if value_type != 7:
+                    raise ValueError('Invalid AWS event-stream event type')
