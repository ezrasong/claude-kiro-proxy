+    event = await asyncio.wait_for(anext(output), 1)
+    assert event.type == 'thinking' and event.native_thinking
+    assert not release.is_set()
+    release.set()
+    tail = [event async for event in output]
+    assert [event.type for event in tail] == ['thinking_signature', 'tool_use']
+
+
+@pytest.mark.asyncio
+async def test_native_reasoning_is_never_parsed_as_executable_bracket_tools(aws_frame: Callable) -> None:
+    raw = aws_frame('reasoningContentEvent', {'text': '[Called Bash with args: {"command":"never execute"}]'})
+    raw += aws_frame('reasoningContentEvent', {'signature': 'sig'})
+    raw += aws_frame('assistantResponseEvent', {'content': 'Done'})
+    result = await collect_stream_to_result(httpx.Response(200, content=raw))
+    assert result.thinking_signature == 'sig'
+    assert result.native_thinking
+    assert not result.tool_calls
