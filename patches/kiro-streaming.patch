+                chunks.append(chunk)
+        assert 'event: error' in ''.join(chunks)
+        assert 'event: message_stop' not in ''.join(chunks)
+    else:
+        with pytest.raises(RuntimeError, match='without content or tools'):
+            await collect_anthropic_response(response, 'claude-opus-5-5', mock_model_cache, mock_auth_manager)
