+@pytest.mark.asyncio
+@pytest.mark.parametrize('finish', ['tool', 'error', 'empty', 'cancel'])
+async def test_keepalive_preserves_silent_generation_and_closes_on_disconnect(
+    finish, mock_model_cache, mock_auth_manager,
+):
+    """One request survives multiple idle intervals; cancellation closes it."""
+    import asyncio
+    release = asyncio.Event()
+
+    class SlowKiroStream(httpx.AsyncByteStream):
+        async def __aiter__(self):
+            yield b'{"content":""}'
+            await release.wait()
+            if finish == 'error':
+                raise httpx.ReadTimeout('Upstream inactivity timeout')
+            if finish == 'empty':
+                yield b'{"contextUsagePercentage":1}'
+                return
+            yield b'{"name":"Bash","toolUseId":"toolu_slow","input":{"command":"echo CHECK"},"stop":true}{"contextUsagePercentage":1}'
+
+    response = httpx.Response(200, stream=SlowKiroStream())
+    make_request = AsyncMock()
+    output = stream_with_first_token_retry_anthropic(
+        make_request, 'claude-opus-5-5', mock_model_cache, mock_auth_manager,
+        initial_response=response, max_retries=1,
+    )
+    with patch('kiro.streaming_anthropic._KEEPALIVE_SECONDS', 0.01):
+        assert 'event: message_start' in await anext(output)
+        for _ in range(2):
+            assert 'event: ping' in await asyncio.wait_for(anext(output), 1)
+        if finish == 'cancel':
+            await output.aclose()
+        else:
+            release.set()
+            chunks = []
+            if finish in ('error', 'empty'):
+                with pytest.raises(httpx.ReadTimeout if finish == 'error' else RuntimeError):
+                    async for chunk in output:
+                        chunks.append(chunk)
+                assert 'event: error' in ''.join(chunks)
+                assert 'event: message_stop' not in ''.join(chunks)
+            else:
+                chunks = [chunk async for chunk in output]
+                raw = ''.join(chunks)
+                assert raw.count('"id": "toolu_slow"') == 1
+                assert '"stop_reason": "tool_use"' in raw
+                assert 'event: message_stop' in raw
+    assert response.is_closed
+    make_request.assert_not_called()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('stream', [True, False])
