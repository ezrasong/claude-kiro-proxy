+    """Build fragmented AWS frames with a pending tool and a terminal refusal."""
+    def frame(event: str, value: Dict[str, Any]) -> bytes:
+        """Encode an AWS event frame, including header and message CRCs."""
+        key = b':event-type'
+        name = event.encode()
+        headers = bytes([len(key)]) + key + b'\x07' + len(name).to_bytes(2, 'big') + name
+        payload = json.dumps(value, separators=(',', ':')).encode()
+        prelude = struct.pack('>II', 16 + len(headers) + len(payload), len(headers))
+        message = prelude + struct.pack('>I', zlib.crc32(prelude)) + headers + payload
+        return message + struct.pack('>I', zlib.crc32(message))
+
+    raw = frame('toolUseEvent', {'name': 'never_run', 'toolUseId': 'pending', 'input': '{}', 'stop': True})
+    raw += frame('metadataEvent', {
+        'stopDetails': {'refusal': {'category': 'REASONING_EXTRACTION', 'explanation': 'do-not-forward-private-detail'}},
+        'stopReason': 'CONTENT_FILTERED',
+    })
+    raw += frame('assistantResponseEvent', {'content': 'DO_NOT_SHOW_AFTER_REFUSAL'})
+
+    class Stream(httpx.AsyncByteStream):
+        """Deliver frames across arbitrary byte boundaries without a network."""
+        async def __aiter__(self) -> AsyncGenerator[bytes, None]:
+            for offset in range(0, len(raw), 7):
+                yield raw[offset:offset + 7]
+
+    return httpx.Response(200, stream=Stream())
