+@pytest.mark.parametrize('reason_first', [False, True])
+def test_metadata_refusal_key_order_and_split_frames(reason_first: bool) -> None:
+    """Refusal metadata must survive key reordering and arbitrary chunk splits."""
+    pairs = [('stopDetails', {'refusal': {'category': 'REASONING_EXTRACTION'}}), ('stopReason', 'CONTENT_FILTERED')]
+    value = dict(reversed(pairs) if reason_first else pairs)
+    raw = json.dumps(value, separators=(',', ':')).encode()
+    parser = AwsEventStreamParser()
+    events = []
+    for offset in range(0, len(raw), 3):
+        events.extend(parser.feed(raw[offset:offset + 3]))
+    assert len(events) == 1
+    assert events[0]['type'] == 'refusal'
+    assert 'REASONING_EXTRACTION' in events[0]['data']
+
+
+@pytest.mark.parametrize('details', [None, 'invalid', {}, {'refusal': 'invalid'}, {'refusal': {'category': 'secret\nvalue'}}])
+def test_filtered_metadata_uses_safe_fallback(details: object) -> None:
+    """Missing or malformed details cannot hide a refusal or inject diagnostics."""
+    events = AwsEventStreamParser().feed(json.dumps({'stopReason': 'CONTENT_FILTERED', 'stopDetails': details}).encode())
+    assert events[0]['type'] == 'refusal'
+    assert '(CONTENT_FILTERED)' in events[0]['data']
+    assert 'secret' not in events[0]['data']
+
+
+def test_normal_stop_metadata_is_not_a_refusal() -> None:
+    """Ordinary terminal metadata must not add synthetic response content."""
+    assert AwsEventStreamParser().feed(b'{"stopReason":"END_TURN"}') == []
